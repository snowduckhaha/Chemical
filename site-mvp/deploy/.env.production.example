# Public domain, without https://
SITE_DOMAIN=www.origin-chemical.com

# Production builds Docker images from the commit checked out by deploy.sh.
# Do not set BACKEND_IMAGE or FRONTEND_IMAGE here: commit-derived local tags
# keep the previous release available for automatic rollback.
AUTO_ROLLBACK=1

# Keep outside the Git working tree. The backend writes uploaded images here.
UPLOADS_DIR=/opt/chemical/uploads

# Keep outside the Git working tree. MySQL data is persisted on the host,
# not in the container's writable layer.
MYSQL_DATA_DIR=/opt/chemical/mysql-data

# Host directory for weekly full database baselines, daily binary-log
# increments and upload-file snapshots. Keep it outside the Git worktree.
BACKUP_DIR=/opt/chemical/backups
BACKUP_RETENTION_DAYS=35
# Must be longer than the full-backup cycle plus enough recovery margin.
MYSQL_BINLOG_RETENTION_SECONDS=1296000

# MySQL passwords: generate independent, high-entropy values.
MYSQL_ROOT_PASSWORD=replace-with-a-random-24-plus-character-password
MYSQL_PASSWORD=replace-with-a-different-random-24-plus-character-password

# Random value reserved for the internal deployment-status API. Keep it
# independent from database passwords even when no external workflow is used.
DEPLOYMENT_CALLBACK_TOKEN=replace-with-a-random-32-plus-character-token

# Initial admin users are optional; use BCrypt hashes only.
SITE_ADMIN_USERNAME=admin
SITE_ADMIN_PASSWORD_HASH='$2a$12$wyPdNGzaRjTi7RejrQvXsehSSbhTyG718J1GtcBCR7pNN/5XVutfi'
SITE_OPERATOR_USERNAME=operator
SITE_OPERATOR_PASSWORD_HASH='$2a$12$rDdZ4TV/O/UVu7R/ETc9cuTcUJbXEazRBpmKBd5naOdh2w1MJgE1i'
