# CDN handles HTTPS termination; this server only accepts HTTP from the CDN origin.
server {
    # default_server so requests addressed by raw IP (or any unmatched Host)
    # land here instead of the stock nginx welcome server block.
    listen 80 default_server;
    server_name ${SITE_DOMAIN} www.${SITE_DOMAIN};

    client_max_body_size 4m;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # Public read-only content APIs may be cached by CDN for a short time.
    # The query string (especially lang/page/pageSize) must remain part of the
    # CDN cache key.
    location ~ ^/api/v1/(?:nav$|home$|products(?:/|$)|applications(?:/|$)|news(?:/|$)|seo$) {
        limit_except GET HEAD { deny all; }
        proxy_pass http://backend:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Cookie "";
        proxy_hide_header Cache-Control;
        proxy_hide_header Set-Cookie;
        add_header Cache-Control "public, max-age=60, s-maxage=300, stale-while-revalidate=60" always;
        proxy_read_timeout 60s;
    }

    # Authentication, CSRF, admin operations, uploads, inquiries and analytics
    # always reach the origin and must never be stored by browsers or CDN.
    location /api/ {
        proxy_pass http://backend:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "private, no-store" always;
        proxy_read_timeout 60s;
    }

    location /uploads/ {
        alias /srv/uploads/;
        try_files $uri =404;
        expires 7d;
        add_header Cache-Control "public, max-age=604800";
    }

    location = /sitemap.xml {
        proxy_pass http://backend:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header Cache-Control "public, max-age=900" always;
    }

    location = /robots.txt {
        proxy_pass http://backend:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header Cache-Control "public, max-age=3600" always;
    }

    location ~ ^/(zh|en)/admin/ {
        proxy_pass http://frontend:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header Cache-Control "private, no-store" always;
    }

    location / {
        proxy_pass http://frontend:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
